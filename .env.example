# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Used to sign the admin session cookie (set a long random string, e.g. openssl rand -base64 64)
ADMIN_SESSION_SECRET=replace-with-long-random-secret

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# ── AdSense ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_GOOGLE_ADSENSE_SLOT_DEFAULT=xxxxxxxxxx
NEXT_PUBLIC_GOOGLE_ADSENSE_SLOT_INFEED=xxxxxxxxxx
NEXT_PUBLIC_GOOGLE_ADSENSE_LAYOUT_KEY_INFEED=xx+xx+xx-xx+xx
NEXT_PUBLIC_GOOGLE_ADSENSE_SLOT_MULTIPLEX=xxxxxxxxxx

# ── AdMob (native) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
NEXT_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
NEXT_PUBLIC_ADMOB_ANDROID_NATIVE_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
NEXT_PUBLIC_ADMOB_ANDROID_REWARDED_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
NEXT_PUBLIC_ADMOB_ANDROID_REWARDED_INTERSTITIAL_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
NEXT_PUBLIC_ADMOB_ANDROID_APP_OPEN_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
NEXT_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
NEXT_PUBLIC_ADMOB_IOS_INTERSTITIAL_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
NEXT_PUBLIC_ADMOB_IOS_NATIVE_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
NEXT_PUBLIC_ADMOB_IOS_REWARDED_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
NEXT_PUBLIC_ADMOB_IOS_REWARDED_INTERSTITIAL_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
NEXT_PUBLIC_ADMOB_IOS_APP_OPEN_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
CAPACITOR_ADMOB_APP_ID_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
CAPACITOR_ADMOB_APP_ID_IOS=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx

# Optional: load live web app in native wrapper (leave empty for bundled build)
CAPACITOR_SERVER_URL=

# ── Logo.dev ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_LOGO_DEV_PUBLIC_KEY=your-logo-dev-public-key

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── Generic billing webhook ───────────────────────────────────────────────────
BILLING_WEBHOOK_SECRET=replace-with-long-random-secret

# ── Manual upgrade (disabled by default — do NOT enable in production) ────────
ALLOW_MANUAL_UPGRADE=false
MANUAL_UPGRADE_SECRET=replace-with-long-random-secret

# ── Upstash Redis (recommended for production rate limiting) ──────────────────
# Without this, rate limits are in-memory only and reset on every server restart.
# Get free credentials at https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
